<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Least privilege: no camera, SMS, microphone, contacts or phone permission (QR scanning, speech input and payment
         run in Google / UPI apps), and no INTERNET either, so nothing in the app can send data off the phone.
         The remove markers also strip these if a library tries to add them. Debug builds add INTERNET back for
         hot reload (src/debug/AndroidManifest.xml); release builds have none.
         ACCESS_NETWORK_STATE stays: Google's QR scanner library schedules a background job with a network condition,
         and Android 14+ refuses that job (and the scan fails) without it. It only reads whether a network exists,
         is granted silently, and cannot send anything. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <!-- CAMERA comes with the built-in fallback QR scanner. It is asked for only if Google's scanner is not
         available on the phone, and only when the user taps "Scan a QR code". -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <!-- Keep the safety history and saved payees on this phone: no cloud backup, adb backup or device-to-device copy -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:label="Easy Pay Safe Pay"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Built-in fallback QR scanner (ZXing): keep it upright like the rest of the app -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="screenOrientation" />
        <!-- Download the ML Kit QR scanner module at install time instead of on first scan -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ package visibility: the apps we hand off to -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" android:host="pay" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Remote-control apps used in screen-sharing scams (MainActivity.REMOTE_APPS) -->
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.teamviewer.market.mobile" />
        <package android:name="com.teamviewer.host.market" />
        <package android:name="com.carriez.flutter_hbb" />
        <package android:name="com.sand.airdroid" />
        <package android:name="com.sand.airmirror" />
    </queries>
</manifest>
